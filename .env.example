# Local: docker compose up -d
DATABASE_URL=postgres://postgres:postgres@localhost:54329/wine_tasting
# At least 32 characters, e.g. via: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters
# Optional: fixed base URL for QR codes (otherwise taken from the request host)
APP_URL=
# Optional: separate connection for migrations only (e.g. Supabase session pooler, see DEPLOYMENT.md)
# MIGRATION_DATABASE_URL=
# Optional: protects the daily cleanup route /api/cron/purge (at least 16 characters, e.g. openssl rand -hex 32)
# CRON_SECRET=
