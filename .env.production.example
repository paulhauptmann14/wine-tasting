# For docker-compose.prod.yml – copy to .env.production (not committed)

# Database password, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=
# At least 32 characters, e.g.: openssl rand -base64 48
SESSION_SECRET=
# Protects the daily cleanup job, e.g.: openssl rand -hex 32
CRON_SECRET=
# Public address for QR codes, e.g. https://wein.example.de
APP_URL=
# Database storage location – on the Pi a folder on the SSD
DB_DATA_DIR=./data/postgres
# Local port of the app
APP_PORT=3000
# Only with --profile tunnel: token from Cloudflare Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=
