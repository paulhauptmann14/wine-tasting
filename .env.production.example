# Für docker-compose.prod.yml – kopieren nach .env.production (wird nicht committet)

# Datenbank-Passwort, z. B.: openssl rand -base64 24
POSTGRES_PASSWORD=
# Mind. 32 Zeichen, z. B.: openssl rand -base64 48
SESSION_SECRET=
# Öffentliche Adresse für QR-Codes, z. B. https://wein.example.de
APP_URL=
# Speicherort der Datenbank – auf dem Pi ein Ordner auf der SSD
DB_DATA_DIR=./data/postgres
# Lokaler Port der App
APP_PORT=3000
# Nur mit --profile tunnel: Token aus Cloudflare Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=
